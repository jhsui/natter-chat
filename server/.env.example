# Copy this file to .env and change the values.

# Secret used to sign login tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Port for the API / WebSocket server (the Vite dev server proxies to it)
PORT=3001

# PostgreSQL connection string. Leave unset to use the embedded PGlite
# database in server/data/pglite (no install needed). On Railway, reference the
# Postgres service's variable: DATABASE_URL=${{Postgres.DATABASE_URL}}
# DATABASE_URL=postgres://user:password@localhost:5432/chat

# Where the embedded PGlite database is stored when DATABASE_URL isn't set
# PGLITE_DIR=./data/pglite

# Supabase Storage for profile pictures and images sent in chats (see
# "Avatars and chat images" in the README). Without these, everything works
# except uploading avatars and sending images.
# SUPABASE_URL=https://your-project.supabase.co
# The *secret* key (sb_secret_... or the legacy service_role key). Server only!
# SUPABASE_SECRET_KEY=sb_secret_...
# A public bucket for avatars; defaults to "avatars"
# SUPABASE_BUCKET=avatars
# A private bucket for images sent in chats; defaults to "chat-images"
# SUPABASE_CHAT_BUCKET=chat-images

# "Try the demo" on the sign-in page: temporary guest accounts and Natter Bot
# (see "Demo" in the README). On unless this is set to "off".
# DEMO=off

# Link previews: when a message contains a link, the server downloads that
# page to read its title, description and picture. Set to "off" to disable.
# LINK_PREVIEWS=off

# Only needed if you host the React app on a different domain than the API
# CLIENT_ORIGIN=https://your-frontend.example.com

# How many proxies sit in front of the server, so the rate limits see each
# visitor's real IP instead of the proxy's (see "Rate limits" in the README).
# Set it to 1 on Railway. Leave it unset when nothing is in front of the
# server: otherwise anyone could fake their IP with an X-Forwarded-For header.
# TRUST_PROXY=1
